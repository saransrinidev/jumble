# MongoDB Atlas connection string. Backend only — never expose to the frontend.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI=
# Database name used inside the cluster.
MONGODB_DB=jumble

# Shared password the host types at /control to access host controls.
HOST_PASSWORD=change-me

# The exact origin of the deployed frontend (for CORS + cookies).
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
